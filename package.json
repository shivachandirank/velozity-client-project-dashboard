{
  "name": "velozity-client-project-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Velozity Client Project Dashboard monorepo",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "seed": "npm run seed --workspace=server",
    "test": "npm run test --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "deep-eql": "^5.0.2",
    "mlly": "^1.8.2",
    "prisma": "^5.22.0",
    "type-detect": "^4.1.0"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "^0.28.2",
    "esbuild": "^0.28.2"
  }
}
